<odoo>
    <record id="view_pos_session_form_inherit_button" model="ir.ui.view">
        <field name="name">pos.session.form.button.custom</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">

            <!-- Make field available in view -->
            <xpath expr="//sheet" position="inside">
                <field name="has_multiple_open_sessions" invisible="1"/>
            </xpath>

            <!-- Insert after the "Continuar venta" button -->
            <xpath expr="//button[@name='open_frontend_cb']" position="after">
                <button name="action_change_owner"
                        string="Change owner to odoobot"
                        type="object"
                        class="btn btn-secondary"
                        attrs="{'invisible': [('has_multiple_open_sessions','=',False)]}"/>
            </xpath>

        </field>
    </record>
</odoo>
